{
  "name": "dsh-vscode-bridge-he",
  "version": "1.0.4",
  "type": "module",
  "description": "Send a VS Code selection or file path into the open DSH conversation as an @path reference, without sending the message.",
  "license": "MulanPSL-2.0",
  "author": "<YOUR NAME>",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "vscode",
    "editor",
    "context"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<OWNER>/dsh-vscode-bridge.git",
    "directory": "dsh-vscode-bridge"
  },
  "homepage": "https://github.com/<OWNER>/dsh-vscode-bridge#readme",
  "bugs": {
    "url": "https://github.com/<OWNER>/dsh-vscode-bridge/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/icon-180.png",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-alpha.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.1-alpha.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
